{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Iridium (Release)",
			"type": "shell",
			"command": "./buildRelease.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": "$gcc",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Build Iridium (Debug)",
			"type": "shell",
			"command": "./build.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": "$gcc"
		}
	]
}